APP_NAME="Tryout Sample"
MODE="development"
SERVER="0.0.0.0"
PORT=8080

#Database Config
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

GOMAIL_SMTP_HOST="smtp.gmail.com"
GOMAIL_SMTP_PORT=587
GOMAIL_SENDER_NAME="Telisik System <telisikgo@gmail.com>"
GOMAIL_AUTH_EMAIL=
GOMAIL_AUTH_PASSWORD=

#Pool Config
DB_POOL_MAX_CONN=10
DB_POOL_IDLE_CONN=5
DB_POOL_LIFE_TIME=30000

#JWT Config
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES_COUNT=

IS_TRYOUT_BYPASS=true
IS_OTP_BYPASS=true

#AI Provider Configuration
# Set AI_PROVIDER to "gemini" or "openai"
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional: override default model names (default: gemini-2.5-flash)
# AI_MODEL=gemini-2.5-flash
# AI_MODEL_VISION=gemini-2.5-flash
# Daily request limit (default: 50)
# AI_DAILY_LIMIT=50

# Cost budget enforcement (paid tier) — prevents runaway spending
# Daily budget in USD (default: $0.10/day). Set 0 to disable.
# AI_DAILY_BUDGET_USD=0.10
# Monthly budget in USD (default: $1.00/month). Set 0 to disable.
# AI_MONTHLY_BUDGET_USD=1.00